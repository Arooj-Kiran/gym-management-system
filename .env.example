# Copy to .env (or run `npm run db:setup`, which writes .env for you).
# Placeholders only — never put real secrets in this file.

# --- Server ---
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
TRUST_PROXY=false
LOG_LEVEL=info

# --- Database (PostgreSQL 17) ---
DATABASE_URL=postgres://gym_app:CHANGE_ME@localhost:5432/gym_dev
# Tests refuse to run unless the database name ends in _test and differs from DATABASE_URL.
TEST_DATABASE_URL=postgres://gym_app:CHANGE_ME@localhost:5432/gym_test

# --- Sessions and login protection ---
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
ACCOUNT_LOCKOUT_THRESHOLD=10
ACCOUNT_LOCKOUT_MINUTES=15

# --- Gym locale ---
GYM_TIMEZONE=Asia/Karachi
CURRENCY_CODE=PKR

# --- Uploads (member photos; relative paths resolve from the repository root) ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=2

# --- Access control (Stage 4) ---
ACCESS_DUPLICATE_SCAN_WINDOW_SECONDS=60
# Statement timeout for an access decision; anything slower is denied (fail closed).
ACCESS_DB_TIMEOUT_MS=2000
ACCESS_SCAN_RATE_LIMIT_PER_MINUTE=60
# Simulated fingerprint scanner for development and demos. The server refuses to start with
# this set to true when NODE_ENV=production.
BIOMETRIC_SIMULATOR_ENABLED=true

# --- Notification channels (Stage 7; see docs/NOTIFICATIONS.md) ---
# Leave a channel's values empty to keep it off: in-app notifications still work and each
# skipped send is recorded as NOT_CONFIGURED. Put real credentials in .env only, never here.
# Email (SMTP). Port 465 uses implicit TLS; other ports use STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender, e.g. "Iron Haven Gym <no-reply@your-gym.example>"
SMTP_FROM=
# SMS and WhatsApp (Twilio). WhatsApp needs a WhatsApp-enabled sender number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 number, e.g. +15005550006
TWILIO_SMS_FROM=
# E.164 number without the "whatsapp:" prefix
TWILIO_WHATSAPP_FROM=

# --- First admin (used by `npm run db:seed` only; must be changed at first login) ---
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG

# --- Web (bundled into public JavaScript — never put secrets here) ---
VITE_API_BASE_URL=/api/v1
VITE_DEV_API_PROXY_TARGET=http://localhost:4000

# --- Biometric agent (apps/biometric-agent; runs on the front-desk PC) ---
AGENT_BACKEND_URL=http://localhost:4000/api/v1
# From the Devices screen. The key is shown once; treat it like a password.
AGENT_DEVICE_ID=00000000-0000-0000-0000-000000000000
AGENT_DEVICE_KEY=CHANGE_ME
AGENT_ADAPTER=simulated
AGENT_REQUEST_TIMEOUT_MS=3000
AGENT_OUTBOX_PATH=./data/outbox.jsonl
AGENT_HEARTBEAT_SECONDS=30
